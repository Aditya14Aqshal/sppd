    tb_jabatan {
        int id_jabatan PK
        varchar nama_jabatan
        varchar golongan
        varchar pangkat
        varchar eselon
    }

    tb_pegawai {
        int id_pegawai PK
        varchar nip UK
        varchar nama_lengkap

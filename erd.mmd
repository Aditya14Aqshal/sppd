        varchar unit_kerja
        enum status
        enum jenis_kelamin
        varchar no_hp
        varchar email
        enum jenis_pegawai
    }

    tb_pengguna {
        int id_pengguna PK
        int id_pegawai FK,UK
        varchar username UK
        varchar password
        enum role
        enum status
    }

    tb_unit_kerja {
        int id_unit PK
        varchar nama_unit
        varchar kode_unit
    }

    tb_tujuan {
        int id_tujuan PK
        varchar nama_instansi
        varchar kota
        varchar provinsi
        enum zona
        text alamat
    }

    tb_jenis_kegiatan {
        int id_kegiatan PK
        varchar nama_kegiatan
        enum status
        text keterangan
    }

    tb_anggaran {
        int id_anggaran PK
        varchar kode_anggaran UK
        varchar nama_program
        decimal pagu
        enum status
        year tahun_anggaran
    }

    tb_sppd {
        int id_sppd PK
        int id_pengaju FK
        int id_kegiatan FK
        int id_tujuan FK
        int id_anggaran FK
        int id_pimpinan FK
        varchar no_sppd
        text keperluan
        date tgl_berangkat
        date tgl_kembali
        varchar kendaraan
        enum status
        text catatan_tolak
        datetime tgl_pengajuan
        datetime tgl_persetujuan
    }

    tb_sppd_anggota {
        int id_anggota PK
        int id_sppd FK
        int id_pegawai FK
        varchar peran
    }

    tb_komponen_biaya {
        int id_komponen PK
        enum jenis_biaya
        varchar golongan
        enum zona
        decimal besaran
        year tahun_anggaran
    }

    tb_biaya_perjalanan {
        int id_biaya PK
        int id_sppd FK
        int id_komponen FK
        int jumlah_hari
        decimal besaran_realisasi
        varchar kwitansi_file
    }

    tb_laporan_dinas {
        int id_laporan PK
        int id_sppd FK,UK
        date tgl_aktual_berangkat
        date tgl_aktual_kembali
        text uraian_kegiatan
        text kesimpulan
        varchar bukti_file
    }

    tb_dasar_hukum {
        int id_dasar PK
        varchar judul
        text isi
        year tahun
        enum status
        int urutan
    }

